import pygame
import socket
import pickle
import math

WIDTH, HEIGHT = 1200, 750

# ── Palette ──────────────────────────────────────────────
BG       = (6,   7,  18)
CYAN     = (0,  230, 220)
MAGENTA  = (230,  0, 200)
WHITE    = (255, 255, 255)
GRAY     = (80,  85, 110)
DIM      = (30,  35,  60)
GREEN    = (30,  230, 120)
YELLOW   = (255, 220,  40)

PU_COLORS = {
    "BIG": (30, 230, 120), "WALL": (60, 150, 255), "FAKE": (170, 40, 255),
    "SPEED": (255, 160, 30), "SHRINK": (255, 55, 55), "SLOW": (80, 120, 255), "MULTI": (255, 220, 40)
}
PU_ICON = {"BIG": "▲", "WALL": "█", "FAKE": "◈", "SPEED": "▶", "SHRINK": "▼", "SLOW": "◉", "MULTI": "✦"}

class Network:
    def __init__(self):
        self.client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server = "127.0.0.1"
        self.port   = 5555
        self.p      = self._connect()

    def _connect(self):
        try:
            self.client.connect((self.server, self.port))
            return pickle.loads(self.client.recv(4096))
        except: return None

    def send(self, data):
        try:
            self.client.send(pickle.dumps(data))
            resp = self.client.recv(8192)
            return pickle.loads(resp) if resp else "DISCONNECTED"
        except: return "DISCONNECTED"

# ── Graphics Helpers ─────────────────────────────────────
_glow_cache: dict = {}
def get_circle_glow(radius, color, alpha=55):
    key = (radius, color, alpha)
    if key not in _glow_cache:
        size = radius * 6; surf = pygame.Surface((size, size), pygame.SRCALPHA)
        layers = [(radius * 3, alpha // 4), (radius * 2, alpha // 2), (radius + 4, alpha)]
        for r, a in layers: pygame.draw.circle(surf, (*color, a), (size//2, size//2), r)
        _glow_cache[key] = surf
    return _glow_cache[key]

def draw_glowing_circle(surf, color, pos, radius, alpha=55):
    glow = get_circle_glow(radius, color, alpha)
    surf.blit(glow, (pos[0] - glow.get_width()//2, pos[1] - glow.get_width()//2))
    pygame.draw.circle(surf, color, pos, radius)

def draw_glowing_paddle(surf, color, rect, br=7):
    x, y, w, h = rect
    for expand in [12, 6, 2]:
        g = pygame.Surface((w + expand*2, h + expand*2), pygame.SRCALPHA)
        pygame.draw.rect(g, (*color, max(0, 28-expand*2)), (0, 0, w+expand*2, h+expand*2), border_radius=br+expand)
        surf.blit(g, (x - expand, y - expand))
    pygame.draw.rect(surf, color, rect, border_radius=br)

def make_scanlines(w, h):
    s = pygame.Surface((w, h), pygame.SRCALPHA)
    for y in range(0, h, 3): pygame.draw.line(s, (0,0,0,22), (0,y), (w,y))
    return s

def main():
    pygame.init()
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    clock = pygame.time.Clock()
    f_score = pygame.font.SysFont("Consolas", 78, bold=True)
    f_big = pygame.font.SysFont("Consolas", 34, bold=True)
    f_sm = pygame.font.SysFont("Consolas", 18)
    scanlines = make_scanlines(WIDTH, HEIGHT)

    n = Network()
    if n.p is None: print("Server Offline"); return
    my_p, my_y, voted = n.p, 315, False

    while True:
        input_data = my_y
        if not voted:
            keys = pygame.key.get_pressed()
            if keys[pygame.K_1]: input_data = "NORMAL"; voted = True
            if keys[pygame.K_2]: input_data = "CHAOS"; voted = True

        gs = n.send(input_data)
        if gs == "DISCONNECTED": break

        screen.fill(BG)
        for y in range(0, HEIGHT, 20): pygame.draw.rect(screen, DIM, (WIDTH//2-2, y, 4, 11))

        if gs["mode"] == "voting":
            txt = "WAITING FOR OTHERS..." if voted else "MODE: [1] NORMAL | [2] CHAOS"
            lbl = f_big.render(txt, True, WHITE)
            screen.blit(lbl, lbl.get_rect(center=(WIDTH//2, HEIGHT//2)))
        else:
            # Powerup Timer Bar
            active_timer = max(gs["p1_h_timer"], gs["p2_h_timer"], gs["slow_timer"])
            if active_timer > 0:
                bar_w = (active_timer / 600) * 300
                pygame.draw.rect(screen, DIM, (WIDTH//2 - 150, 15, 300, 10), border_radius=5)
                pygame.draw.rect(screen, GREEN, (WIDTH//2 - 150, 15, bar_w, 10), border_radius=5)

            # Match Timer
            m, s = divmod(gs["match_time"] // 60, 60)
            screen.blit(f_sm.render(f"{m:02d}:{s:02d}", True, GRAY), (WIDTH//2 - 25, 35))

            # Bricks
            for b in gs["bricks"]:
                if b[4]:
                    col = PU_COLORS.get(b[5], WHITE)
                    pygame.draw.rect(screen, (20, 20, 40), (b[0], b[1], b[2], b[3]), border_radius=4)
                    pygame.draw.rect(screen, col, (b[0], b[1], b[2], b[3]), 2, border_radius=4)

            # Crates
            for c in gs["crates"]:
                col = PU_COLORS.get(c[2], YELLOW)
                pygame.draw.rect(screen, col, (c[0]-18, c[1]-18, 36, 36), border_radius=6)
                screen.blit(f_sm.render(PU_ICON.get(c[2], "?"), True, BG), (c[0]-8, c[1]-10))

            # Ball/Countdown
            if gs["countdown"] > 0:
                txt = f_score.render(str(gs["countdown"]//60 + 1), True, WHITE)
                screen.blit(txt, txt.get_rect(center=(WIDTH//2, HEIGHT//2)))
            else:
                draw_glowing_circle(screen, WHITE, (int(gs["ball_pos"][0]), int(gs["ball_pos"][1])), 12)

            # Paddles
            draw_glowing_paddle(screen, CYAN, (38, gs["p1_y"], 14, gs["p1_h"]))
            draw_glowing_paddle(screen, MAGENTA, (WIDTH-52, gs["p2_y"], 14, gs["p2_h"]))

            # Scores
            screen.blit(f_score.render(str(gs["p1_score"]), True, CYAN), (WIDTH//4, 50))
            screen.blit(f_score.render(str(gs["p2_score"]), True, MAGENTA), (WIDTH*3//4, 50))

        screen.blit(scanlines, (0, 0))
        for e in pygame.event.get():
            if e.type == pygame.QUIT: return
        
        keys = pygame.key.get_pressed()
        step = 12
        if keys[pygame.K_w] and my_y > 0: my_y -= step
        if keys[pygame.K_s] and my_y < HEIGHT - (gs["p1_h"] if my_p == 0 else gs["p2_h"]): my_y += step

        pygame.display.flip()
        clock.tick(60)

if __name__ == "__main__":
    main()
